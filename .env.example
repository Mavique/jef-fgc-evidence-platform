# Public build-time values. Only expose values that are safe in browser bundles.
NEXT_PUBLIC_APP_URL=https://fgc.example.org

# Non-secret runtime values.
FGC_APP_URL=https://fgc.example.org
FGC_STAGING_APP_URL=https://staging.fgc.example.org
FGC_PRODUCTION_APP_URL=https://fgc.example.org
FGC_ENVIRONMENT=staging
FGC_EMAIL_PROVIDER=resend
FGC_EMAIL_FROM=no-reply@example.org
FGC_EVIDENCE_STORAGE_PROVIDER=supabase
FGC_EVIDENCE_STORAGE_BUCKET=fgc-evidence
FGC_MAX_UPLOAD_BYTES=10000000
FGC_SESSION_TTL_SECONDS=28800
FGC_VERIFICATION_TOKEN_TTL_SECONDS=86400
FGC_PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
FGC_CF_KV_NAMESPACE_ID=replace-with-staging-kv-namespace-id
FGC_CF_HYPERDRIVE_ID=replace-with-staging-hyperdrive-id
FGC_CF_IMAGES_CONFIGURED=false

FGC_SUPABASE_URL=https://project-ref.supabase.co

# Cloudflare Worker secrets. Configure with `wrangler secret put`; never commit real values.
FGC_SESSION_SECRET=replace-with-at-least-32-random-characters
FGC_EMAIL_API_KEY=replace-with-resend-api-key
FGC_SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
FGC_ADMIN_BOOTSTRAP_TOKEN=replace-with-one-time-bootstrap-token

# Migration-only secret. Use locally or in protected CI migration jobs only.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
