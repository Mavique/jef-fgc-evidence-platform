{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jef-fgc-staging",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker.ts",
  "vars": {
    "FGC_ENVIRONMENT": "staging",
    "FGC_APP_URL": "https://REPLACE-WITH-STAGING-HOSTNAME",
    "NEXT_PUBLIC_APP_URL": "https://REPLACE-WITH-STAGING-HOSTNAME",
    "FGC_EMAIL_PROVIDER": "resend",
    "FGC_EMAIL_FROM": "REPLACE-WITH-STAGING-SENDER",
    "FGC_EVIDENCE_STORAGE_PROVIDER": "supabase",
    "FGC_EVIDENCE_STORAGE_BUCKET": "REPLACE-WITH-STAGING-PRIVATE-BUCKET",
    "FGC_MAX_UPLOAD_BYTES": "10000000"
  },
  "assets": {"directory": "dist/client", "not_found_handling": "none", "binding": "ASSETS"},
  "cache": {"enabled": true},
  "images": {"binding": "IMAGES"},
  "kv_namespaces": [{"binding": "VINEXT_KV_CACHE", "id": "REPLACE_WITH_STAGING_KV_NAMESPACE_ID"}],
  "hyperdrive": [{"binding": "HYPERDRIVE", "id": "REPLACE_WITH_STAGING_HYPERDRIVE_ID"}]
}
