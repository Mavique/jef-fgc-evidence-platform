{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jengrac-education-foundation-website",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./worker.ts",
	// This base config is local-only. Staging and production bindings are supplied
	// through the environment-specific templates and deployment gate.
	"vars": {
		"FGC_ENVIRONMENT": "development"
	},
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"cache": {
		"enabled": true
	},
	"images": {
		"binding": "IMAGES"
	},
	"kv_namespaces": [],
	"hyperdrive": []
}
