{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jengrac-education-foundation-website",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./worker.ts",
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"cache": {
		"enabled": true
	},
	"images": {
		"binding": "IMAGES"
	},
	"kv_namespaces": [
		{
			"binding": "VINEXT_KV_CACHE",
			"id": "82293750e5a14043809f4ef9c267937d"
		}
	],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "43257d70cdaf438888c9f9db80ad3a22"
		}
	]
}